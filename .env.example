# ─────────────────────────────────────────────────────────────────────────────
# PAS Platform — environment configuration (PAS-0002)
#
# Copy to .env for local development:   cp .env.example .env
# .env is gitignored. NEVER commit real secrets.
#
# Every value here is a DEVELOPMENT PLACEHOLDER. Values marked
# "not-for-deployment" are REJECTED at startup in staging and production —
# copying this file into a deployed environment fails fast by design.
#
# In development and test, every variable is optional: PAS starts with none set.
# In staging and production, the variables marked [REQUIRED] must be supplied.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
PAS_ENV=development

# ── DATABASE ────────────────────────────────────────────── PAS-0101, PAS-0102
PAS_DATABASE_URL=postgresql://pas:pas@localhost:5432/pas_development   # [REQUIRED]
# PAS_DATABASE_POOL_MIN=2
# PAS_DATABASE_POOL_MAX=10
# PAS_DATABASE_SSL=false
# PAS_DATABASE_STATEMENT_TIMEOUT_MS=30000

# ── OBJECT_STORAGE ──────────────────────────────── PAS-0604, Part I §11
PAS_OBJECT_STORAGE_ENDPOINT=http://localhost:9000                      # [REQUIRED]
PAS_OBJECT_STORAGE_REGION=us-east-1                                    # [REQUIRED]
PAS_OBJECT_STORAGE_BUCKET=pas-sources-development                      # [REQUIRED]
PAS_OBJECT_STORAGE_ACCESS_KEY_ID=pas-development-access-key-not-for-deployment        # [REQUIRED] secret
PAS_OBJECT_STORAGE_SECRET_ACCESS_KEY=pas-development-secret-key-not-for-deployment    # [REQUIRED] secret
# PAS_OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Private source URLs must not become permanent public URLs (Part I §11):
# PAS_OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── SESSION ──────────────────────────────────────────────────────── PAS-0202
PAS_SESSION_SECRET=pas-development-session-secret-not-for-deployment   # [REQUIRED] secret, min 32 chars
# PAS_SESSION_COOKIE_NAME=pas_session
# PAS_SESSION_TTL_SECONDS=43200
# Must be true when deployed; an explicit false is rejected:
# PAS_SESSION_COOKIE_SECURE=false
# PAS_SESSION_COOKIE_SAME_SITE=lax

# ── AUTHENTICATION ───────────────────────────────────────────────── PAS-0202
# PAS_AUTH_MIN_PASSWORD_LENGTH=12
# PAS_AUTH_MAX_FAILED_ATTEMPTS=5
# PAS_AUTH_LOCKOUT_SECONDS=900
# PAS_AUTH_PASSWORD_HASH_MEMORY_KIB=19456
# PAS_AUTH_PASSWORD_HASH_ITERATIONS=2

# ── ENCRYPTION ───────────────────────────────────────────────────────────────
PAS_ENCRYPTION_KEY=pas-development-encryption-key-not-for-deployment   # [REQUIRED] secret, min 32 chars
# PAS_ENCRYPTION_KEY_VERSION=1
# PAS_ENCRYPTION_ALGORITHM=aes-256-gcm

# ── PUBLIC_URL / API_URL ────────────────────────────── PAS-2803 canonical URLs
PAS_PUBLIC_URL=http://localhost:3000                                   # [REQUIRED]
PAS_API_URL=http://localhost:4000                                      # [REQUIRED]

# ── WORKER ───────────────────────────────── PAS-0304, PAS-0305, PAS-1303
# PAS_WORKER_CONCURRENCY=4
# PAS_WORKER_POLL_INTERVAL_MS=1000
# PAS_WORKER_MAX_ATTEMPTS=5          # attempts before DEAD_LETTER
# PAS_WORKER_BACKOFF_BASE_MS=1000
# PAS_WORKER_BACKOFF_MAX_MS=300000
# PAS_WORKER_CLAIM_TIMEOUT_MS=300000

# ── AGENT_PROVIDERS ─────────────────────────────────── PAS-1601, PAS-1602
# PAS starts with no provider configured. Application code may never call a
# provider SDK directly — everything routes through the Agent Gateway.
# PAS_AGENT_ENABLED=false
# PAS_AGENT_DEFAULT_PROVIDER=none
# PAS_AGENT_REQUEST_TIMEOUT_MS=60000
# PAS_AGENT_MAX_RETRIES=2
#
# Per-provider credentials. The provider identifier is whatever you name it —
# no vendor appears in the schema. Pattern:
#   PAS_AGENT_<PROVIDER>_API_KEY      (secret)
#   PAS_AGENT_<PROVIDER>_BASE_URL
# PAS_AGENT_ANTHROPIC_API_KEY=
# PAS_AGENT_LOCAL_BASE_URL=http://localhost:11434

# ── OBSERVABILITY ─────────────────────────────────────── PAS-3606, PAS-0004
# PAS_LOG_LEVEL=debug        # trace|debug|info|warn|error|fatal
# PAS_SERVICE_NAME=pas-platform
# PAS_TRACING_ENABLED=false
# PAS_OTLP_ENDPOINT=
# PAS_REDACT_SECRETS=true

# ── EMAIL / NOTIFICATION ─────────────────────────────────────────────────────
# 'console' logs instead of sending; rejected in deployed environments.
# PAS_NOTIFICATION_PROVIDER=console
PAS_NOTIFICATION_FROM_ADDRESS=pas@pas.local                            # [REQUIRED]
# PAS_NOTIFICATION_SMTP_URL=            # secret; required when provider=smtp
# PAS_NOTIFICATION_API_KEY=             # secret; required when provider=http

# ── RATE_LIMITING ────────────────────────────────────────────────── PAS-3603
# Must be true when deployed; an explicit false is rejected.
# PAS_RATE_LIMIT_ENABLED=false
# PAS_RATE_LIMIT_WINDOW_MS=60000
# PAS_RATE_LIMIT_MAX_REQUESTS=300
# PAS_RATE_LIMIT_MAX_REQUESTS_AUTHENTICATED=1000

# ── SERVER ───────────────────────────────────────────────────────────────────
# PAS_API_PORT=4000
# PAS_WEB_PORT=3000
